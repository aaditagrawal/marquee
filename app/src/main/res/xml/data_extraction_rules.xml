<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: allowBackup="false" stops cloud backup but not device-to-device transfer. Exclude
  everything from both, so the server address, access token (marquee_session prefs) and caches
  never leave this install.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
